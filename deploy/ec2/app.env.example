# =============================================================================
# insur-iq EC2 app box — environment file
# =============================================================================
# Copy to app.env and fill in. NEVER commit app.env — it holds secrets and is
# gitignored. Most infra-derived values can be generated with:
#
#   terraform -chdir=infra/terraform-ec2 output -raw app_env_snippet > deploy/ec2/app.env
#
# then fill the __FILL__ placeholders (auth + LLM keys) by hand.
#
# This template lists EVERY variable the stack consumes. Uncommented entries are
# required (or have a sensible value already). Commented entries are optional —
# uncomment to override the default shown. Defaults shown match the application's
# built-in defaults; compose passes the same default when the var is unset, so
# leaving a knob commented is identical to the app's own default.
# =============================================================================

# ---- Images ----------------------------------------------------------------
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
BACKEND_TAG=1.0.0
WEB_TAG=1.0.0
AUTH_TAG=latest

# ---- Public host -----------------------------------------------------------
DOMAIN=insuriq.acmecorp.com

# ---- Django core -----------------------------------------------------------
DEBUG=False
APP_ENV=PROD
SECRET_KEY=__FILL__
WEBHOOK_SECRET_KEY=__FILL__
# Auto-derive these from DOMAIN if you prefer; explicit is fine too.
ALLOWED_HOSTS=insuriq.acmecorp.com
CSRF_TRUSTED_ORIGINS=https://insuriq.acmecorp.com
HOST_NAME=https://insuriq.acmecorp.com
# Optional webhook the backend POSTs to when a policy extraction completes/fails.
# Empty (default) = no callback fired; consumers poll the request endpoint instead.
# POLICY_EXTRACT_CALLBACK_URL=https://insuriq.acmecorp.com/service-api/<webhook-path>

# ---- Database (direct to RDS — no Proxy) -----------------------------------
# DB_PASSWORD: aws secretsmanager get-secret-value --secret-id <rds_master_secret_arn> \
#   --query SecretString --output text | jq -r .password
DB_HOST=insur-iq-prod-ec2.xxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=insur_iq
DB_PASSWORD=__FILL_FROM_SECRETS_MANAGER__
DB_NAME=insure_iq
DB_NAME_AUTH=auth

# ---- Redis (container on this box) / Celery --------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
CELERY_CACHE_BACKEND=django-cache

# ---- S3 --------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_STORAGE_BUCKET_NAME=insur-iq-prod-ec2-uploads
# MinIO / custom-endpoint only — leave blank for real AWS S3.
AWS_S3_ENDPOINT_URL=
AWS_S3_PUBLIC_ENDPOINT_URL=
# S3 client tuning — defaults suit real AWS S3; override only for MinIO/path-style.
# AWS_S3_ADDRESSING_STYLE=virtual
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_QUERYSTRING_EXPIRE=3600
# Static AWS credentials are NOT set here: the app box uses its EC2 instance
# profile (IAM role) and boto3 picks it up automatically. Uncomment ONLY if you
# are not using an instance profile (and add them to docker-compose.app.yml).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Sender address for Better Auth transactional email (verification, etc.).
AWS_SENDER_EMAIL=

# ---- Rhobots Extract OCR (GPU box private IP) ------------------------------
MINERVA_API_URL=http://10.30.64.10:8000
# Extraction throughput / limits — defaults are fine for most workloads.
# MINERVA_TIMEOUT_SECONDS=300
# PIPELINES_MAX_PAGES=50
# MINERU_CHUNK_PAGES=50
# MINERU_MAX_WORKERS=4
# MINERU_CHUNK_TIMEOUT=600
# CINS_SHEET_CONCURRENCY=4

# ---- Auth (Better Auth) ----------------------------------------------------
# DATABASE_STRING for auth is composed in compose from DB_* above + DB_NAME_AUTH.
BETTER_AUTH_SECRET=__FILL__
REQUIRE_EMAIL_VERIFICATION=false
# OAuth providers (optional — leave blank to disable a provider):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- LLM -------------------------------------------------------------------
LLM_PROVIDER=gemini
# GOOGLE_API_KEY is the Gemini key the backend reads (same value as GEMINI_API_KEY).
GOOGLE_API_KEY=__FILL__
GEMINI_API_KEY=__FILL__
GEMINI_MODEL=gemini-2.5-flash
POLICY_EXTRACT_GEMINI_MODEL=gemini-2.5-flash-lite
# OpenAI / Anthropic alternatives (only the selected provider's keys are read):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
EXCEL_AI_CLASSIFICATION_ENABLED=true

# ---- Web (Nuxt SSR) — URLs derive from DOMAIN; override only if needed ------
# NUXT_PUBLIC_API_SCHEME=https
# NUXT_PUBLIC_ENABLED_SOCIAL_PROVIDERS=google,github
# NUXT_APP_BASE_URL=/

# ---- Observability (optional) ----------------------------------------------
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
