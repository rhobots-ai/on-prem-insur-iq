# =============================================================================
# insur-iq GPU box — Rhobots Extract environment file
# =============================================================================
# Copy to gpu.env and fill in. gpu.env is gitignored — never commit it.
# =============================================================================

# Rhobots Extract container image (ECR or vendor registry).
RHOBOTS_EXTRACT_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/insur-iq/rhobots-extract:latest

# Rhobots Extract listens on :8000 inside the container (mapped to the host).
RHOBOTS_EXTRACT_PORT=8000

# Model / device knobs — set per the Rhobots Extract image's documented variables.
# Example:
# RHOBOTS_EXTRACT_DEVICE=cuda
# RHOBOTS_EXTRACT_MODEL=pipeline
